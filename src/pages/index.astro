---
import Scene from "../components/Scene.astro";
import { hudController } from "../components/SceneClient.js";
---

<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<title>Sistema Solar HUD</title>
		<link rel="stylesheet" href="/src/styles/global.css" />
		<link
			href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<script type="module" src="../src/components/SceneClient.js" defer
		></script>
		<script src="https://unpkg.com/alpinejs" defer></script>
	</head>

	<body class="bg-black text-white min-h-screen overflow-hidden relative">
		<!-- Escena 3D -->
		<Scene client:load style="position: absolute; z-index: 1;"/>

		<!-- HUD estilo visor de casco -->
		<div
			class="hud-container absolute top-0 left-0 w-full h-full flex flex-col justify-between p-6"
			style="z-index: 2;"
			x-data="hudController()"
			x-init="init()"
		>
			<!-- Reflejo y marco -->
			<div class="helmet-reflection"></div>
			<div class="hud-frame"></div>

			<!-- Parte superior: Fecha y Hora -->
			<div class="flex justify-between items-center">
				<div class="hud-box">
					<p class="hud-label">
						FECHA: <span id="current-date" class="hud-value"></span>
					</p>
				</div>
				<div class="hud-box">
					<p class="hud-label">
						HORA: <span id="current-time" class="hud-value"></span>
					</p>
				</div>
			</div>

			<!-- Botón principal -->
			<div class="flex justify-center pb-10">
				<button
					@click="comenzarMision()"
					id="comenzar-btn"
					class="hud-btn" style="pointer-events: auto;">COMENZAR</button
				>
				<button
					@click="finalizarMision()"
					id="finalizar-btn"
					class="hud-btn" 
					style="display: none;">FINALIZAR</button
				>
			</div>

			<!-- Botón de explorar -->
			<button id="explore-btn" style="display: none;" class="hud-btn"
				>EXPLORAR</button
			>
		</div>
	</body>
</html>
